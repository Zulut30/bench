{
  "name": "practical-model-bench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Практический бенчмарк моделей: mock, OpenRouter, подписочные CLI и слепое A/B",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx src/cli.ts",
    "bench:demo": "tsx src/cli.ts",
    "bench:compare": "tsx src/cli.ts",
    "browser:install": "playwright install chromium",
    "sandbox:build": "docker build -t practical-bench-sandbox:1 ./sandbox",
    "bench:smoke": "tsx src/cli.ts run --provider mock --profile smoke",
    "bench:standard": "tsx src/cli.ts run --provider mock --profile standard",
    "release:check": "npm run typecheck && npm test && npm run bench:smoke"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "promptfoo": "0.123.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "basic-ftp": "6.2.1"
  }
}
